      "h": "60",
      "srcset": ""
    },
    {
      "t": "h2",
      "text": "Innovation"
    },
    {
      "t": "p",
      "text": "We foster a culture where new ideas are encouraged, and creativity is celebrated.",
      "html": null
    },
    {
      "t": "img",
      "src": "https://www.rotozest.com/wp-content/uploads/elementor/thumbs/badge-r1fvn5l1vwiti5h45z2whk4r95w9j0ifoazwkspsns.png",
